components:
  schemas:
    AdminUser:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        email:
          type: string
          format: email
          maxLength: 254
        full_name:
          type: string
          maxLength: 255
        role:
          $ref: '#/components/schemas/RoleEnum'
        current_level:
          $ref: '#/components/schemas/CurrentLevelEnum'
        is_active:
          type: boolean
        is_staff:
          type: boolean
        date_joined:
          type: string
          format: date-time
          readOnly: true
      required:
      - date_joined
      - email
      - full_name
      - id
    AdminUserRequest:
      type: object
      properties:
        email:
          type: string
          format: email
          minLength: 1
          maxLength: 254
        password:
          type: string
          writeOnly: true
          minLength: 8
        full_name:
          type: string
          minLength: 1
          maxLength: 255
        role:
          $ref: '#/components/schemas/RoleEnum'
        current_level:
          $ref: '#/components/schemas/CurrentLevelEnum'
        is_active:
          type: boolean
        is_staff:
          type: boolean
      required:
      - email
      - full_name
    AuthResponse:
      type: object
      properties:
        refresh:
          type: string
        access:
          type: string
        user:
          $ref: '#/components/schemas/User'
      required:
      - access
      - refresh
      - user
    Course:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        title:
          type: string
          maxLength: 255
        level:
          type: integer
        level_detail:
          allOf:
          - $ref: '#/components/schemas/Level'
          readOnly: true
        description:
          type: string
        price:
          type: integer
          maximum: 2147483647
          minimum: 0
          description: Price in Toman; 0 means the course is free.
        is_free:
          type: boolean
          readOnly: true
        has_access:
          type: boolean
          readOnly: true
        is_active:
          type: boolean
        lessons_count:
          type: integer
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - has_access
      - id
      - is_free
      - lessons_count
      - level
      - level_detail
      - title
      - updated_at
    CourseProgress:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        course:
          type: integer
        course_title:
          type: string
          readOnly: true
        level:
          type: string
          readOnly: true
        completed_lessons:
          type: integer
          maximum: 2147483647
          minimum: 0
        total_lessons:
          type: integer
          maximum: 2147483647
          minimum: 0
        progress_percent:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,2})?$
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - course
      - course_title
      - id
      - level
      - updated_at
    CourseRequest:
      type: object
      properties:
        title:
          type: string
          minLength: 1
          maxLength: 255
        level:
          type: integer
        description:
          type: string
        price:
          type: integer
          maximum: 2147483647
          minimum: 0
          description: Price in Toman; 0 means the course is free.
        is_active:
          type: boolean
      required:
      - level
      - title
    CurrentLevelEnum:
      enum:
      - A1
      - A2
      - B1
      - B2
      - C1
      - C2
      type: string
      description: |-
        * `A1` - A1
        * `A2` - A2
        * `B1` - B1
        * `B2` - B2
        * `C1` - C1
        * `C2` - C2
    Enrollment:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        course:
          type: integer
          readOnly: true
        course_title:
          type: string
          readOnly: true
        source:
          allOf:
          - $ref: '#/components/schemas/SourceEnum'
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - course
      - course_title
      - created_at
      - id
      - source
    GatewayEnum:
      enum:
      - zarinpal
      type: string
      description: '* `zarinpal` - ZarinPal'
    Lesson:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        course:
          type: integer
        skill:
          type: integer
        skill_detail:
          allOf:
          - $ref: '#/components/schemas/Skill'
          readOnly: true
        title:
          type: string
          maxLength: 255
        content:
          type: string
        audio_url:
          nullable: true
          oneOf:
          - type: string
            format: uri
            maxLength: 200
          - type: string
            maxLength: 0
        video_url:
          nullable: true
          oneOf:
          - type: string
            format: uri
            maxLength: 200
          - type: string
            maxLength: 0
        attachment_url:
          nullable: true
          oneOf:
          - type: string
            format: uri
            maxLength: 200
          - type: string
            maxLength: 0
        order:
          type: integer
          maximum: 2147483647
          minimum: 0
          default: 1
        is_published:
          type: boolean
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - content
      - course
      - created_at
      - id
      - skill
      - skill_detail
      - title
      - updated_at
    LessonProgress:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        lesson:
          type: integer
        lesson_title:
          type: string
          readOnly: true
        status:
          $ref: '#/components/schemas/LessonProgressStatusEnum'
        completed_at:
          type: string
          format: date-time
          nullable: true
      required:
      - id
      - lesson
      - lesson_title
    LessonProgressStatusEnum:
      enum:
      - not_started
      - in_progress
      - completed
      type: string
      description: |-
        * `not_started` - Not started
        * `in_progress` - In progress
        * `completed` - Completed
    LessonRequest:
      type: object
      properties:
        course:
          type: integer
        skill:
          type: integer
        title:
          type: string
          minLength: 1
          maxLength: 255
        content:
          type: string
          minLength: 1
        audio_url:
          nullable: true
          oneOf:
          - type: string
            format: uri
            maxLength: 200
          - type: string
            maxLength: 0
        video_url:
          nullable: true
          oneOf:
          - type: string
            format: uri
            maxLength: 200
          - type: string
            maxLength: 0
        attachment_url:
          nullable: true
          oneOf:
          - type: string
            format: uri
            maxLength: 200
          - type: string
            maxLength: 0
        order:
          type: integer
          maximum: 2147483647
          minimum: 0
          default: 1
        is_published:
          type: boolean
      required:
      - content
      - course
      - skill
      - title
    Level:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        code:
          type: string
          maxLength: 2
        title:
          type: string
          maxLength: 100
        order:
          type: integer
          maximum: 32767
          minimum: 0
      required:
      - code
      - id
      - order
      - title
    LevelRequest:
      type: object
      properties:
        code:
          type: string
          minLength: 1
          maxLength: 2
        title:
          type: string
          minLength: 1
          maxLength: 100
        order:
          type: integer
          maximum: 32767
          minimum: 0
      required:
      - code
      - order
      - title
    LoginRequest:
      type: object
      properties:
        email:
          type: string
          format: email
          minLength: 1
        password:
          type: string
          writeOnly: true
          minLength: 1
      required:
      - email
      - password
    ManualGrade:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        submission:
          type: integer
          readOnly: true
        question:
          type: integer
          readOnly: true
        question_text:
          type: string
          readOnly: true
        question_points:
          type: string
          format: decimal
          pattern: ^-?\d{0,5}(?:\.\d{0,2})?$
          readOnly: true
        answer_text:
          type: string
          readOnly: true
        score:
          type: string
          format: decimal
          pattern: ^-?\d{0,5}(?:\.\d{0,2})?$
        feedback:
          type: string
          nullable: true
        is_correct:
          type: boolean
          readOnly: true
          nullable: true
      required:
      - answer_text
      - id
      - is_correct
      - question
      - question_points
      - question_text
      - submission
    MyProgress:
      type: object
      properties:
        courses:
          type: array
          items:
            $ref: '#/components/schemas/CourseProgress'
        lessons:
